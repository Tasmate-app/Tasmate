{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@tasmate/types": ["../../packages/types/src/index.ts"],
      "@tasmate/core": ["../../packages/core/src/index.ts"],
      "@tasmate/core/*": ["../../packages/core/src/*"]
    }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "types/**/*.d.ts"
  ]
}
