  },
  "scripts": {
    "start": "expo start",
    "start:ngrok": "expo start --tunnel ngrok",
    "android": "expo run:android",
    "build:android": "eas build --platform android --profile preview",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "apk:release": "node ../../scripts/build-android-release.mjs",
    "apk:debug": "npm run prebuild:android && cd android && gradlew.bat :app:assembleDebug",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "export:android": "expo export --platform android",
    "export:ios": "expo export --platform ios"
  },
  "private": true
