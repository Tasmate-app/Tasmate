    "@tasmate/types": "*",
    "expo": "~58.0.21",
    "expo-asset": "~58.0.19",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.14",
    "expo-file-system": "~58.0.13",
    "expo-gl": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.28",
    "expo-sharing": "~58.0.23",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
