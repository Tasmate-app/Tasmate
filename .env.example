# 公開してよい環境変数の例（値はダミー）
# フロントエンドに公開する変数は VITE_ 接頭辞が必要
# VITE_SUPABASE_URL=https://example.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key-here

# サーバー側の秘密情報は VITE_ を付けず、Edge Functions 側のシークレットとして管理する

# Android release 署名（ローカルビルド用）
# keystore はリポジトリ外に置き、パスは絶対パスまたはリポジトリ直下からの相対パスで指定する。
# TASMATE_UPLOAD_STORE_FILE=C:/path/to/tasmate-release.keystore
# TASMATE_UPLOAD_STORE_PASSWORD=your-keystore-password
# TASMATE_UPLOAD_KEY_ALIAS=tasmate
# TASMATE_UPLOAD_KEY_PASSWORD=your-key-password
