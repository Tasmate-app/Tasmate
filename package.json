{
  "name": "tasmate",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "現実の勉強・タスクへの取り組みをキャラクター育成・拠点発展につなげる生活支援型育成ゲーム（ローカル動作プロトタイプ）",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "licenses:generate": "node scripts/generate-licenses.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "^7.18.5",
    "three": "^0.170.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.13.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.0.7",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20"
  }
}
